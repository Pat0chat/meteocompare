<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Permissions minimales — strictement nécessaires au fonctionnement.
        INTERNET : requise pour les requêtes Open-Meteo (seul backend utilisé).
        ACCESS_NETWORK_STATE : pour des futures fonctionnalités offline-aware
        (afficher un bandeau "hors-ligne"). Ne donne accès à aucune donnée perso.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
        Pas de Google Play Services / Firebase / AdMob dans les dépendances,
        donc rien n'injecte la permission AD_ID (Advertising ID). Inutile d'avoir
        un tools:node="remove" — il déclencherait un warning manifest-merger
        ("tagged to remove other declarations but no other declaration present").
        Si une future dépendance l'ajoutait, on remettrait la suppression ici.
    -->

    <application
        android:name=".MeteoCompareApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeteoCompare">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.MeteoCompare.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Per-app language preferences via AppCompat.
            On utilise AppCompatDelegate.setApplicationLocales() pour changer
            la langue à l'exécution. AppCompat a besoin de connaître ce service
            (qui ne tourne jamais — il sert juste de metadata holder) pour
            persister automatiquement le choix de langue à travers les cold
            starts. Sans ça, le toggle change la langue pour la session courante
            mais l'app revient à la langue système au prochain démarrage.
            Voir : https://developer.android.com/guide/topics/resources/app-languages
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
            ─── Widgets MeteoCompare (Glance) ────────────────────────────────

            Le widget expose la météo courante d'une ville favorite sur
            l'écran d'accueil.

            ─── Pourquoi 9 receivers ? ──────────────────────────────────
            Chaque <receiver> = une entrée dans le picker de widgets Android.
            Certains launchers (Pixel 9a et Samsung récents) n'exposent
            typiquement que ~3 tailles par provider dans leur picker et ne
            proposent pas de resize post-drop pour tous les widgets. Pour
            garantir que l'utilisateur puisse choisir n'importe quelle taille
            de 1×1 à 5×2 dès le picker, on déclare un receiver par taille
            "canonique". Le RENDU (composable MeteoWidget partagé) s'adapte
            à la taille réelle via SizeMode.Exact — les receivers ne se
            différencient QUE par leur meta-data XML.

            Sur les launchers plus permissifs (Nova, emulator), un seul
            receiver + resize suffirait. La duplication est le prix à payer
            pour la compatibilité Pixel.

            ─── Ordre de déclaration ─────────────────────────────────────
            Trié par taille CROISSANTE (petit → grand) : d'abord les
            single-row (hauteur 1) du 1×1 au 5×1, puis les double-row
            (hauteur 2) du 2×2 au 5×2. Certains launchers respectent cet
            ordre dans leur picker de widgets. L'ordre est aussi cohérent
            avec [WidgetReceivers.All] — [WidgetReceiversRegistryTest]
            verrouille cette cohérence.

            android:exported="true" est REQUIS pour les widget receivers
            depuis Android 12 — le système doit pouvoir les invoquer depuis
            un autre process (le launcher). Sans exported=true, les widgets
            ne s'installeraient tout simplement pas.

            android:label utilise un format "Météo N×N" homogène pour que
            le user puisse identifier la taille au premier coup d'œil dans
            le picker. Les launchers qui trient alphabétiquement mettent
            "Météo 1×1" avant "Météo 2×1" avant "Météo 2×2" etc.
        -->

        <!-- ═══ Single-row widgets (hauteur = 1 cellule) ═══════════════ -->

        <!-- 1×1 (mini) -->
        <receiver
            android:name=".widget.MeteoWidgetReceiver1x1"
            android:exported="true"
            android:label="@string/widget_label_1x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meteocompare_widget_info_1x1" />
        </receiver>

        <!-- 2×1 (STANDARD, taille par défaut historique) -->
        <receiver
            android:name=".widget.MeteoWidgetReceiver2x1"
            android:exported="true"
            android:label="@string/widget_label_2x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meteocompare_widget_info_2x1" />
        </receiver>

        <!-- 3×1 -->
        <receiver
            android:name=".widget.MeteoWidgetReceiver3x1"
            android:exported="true"
            android:label="@string/widget_label_3x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meteocompare_widget_info_3x1" />
        </receiver>

        <!-- 4×1 -->
        <receiver
            android:name=".widget.MeteoWidgetReceiver4x1"
            android:exported="true"
            android:label="@string/widget_label_4x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meteocompare_widget_info_4x1" />
        </receiver>

        <!-- 5×1 (bandeau) -->
        <receiver
            android:name=".widget.MeteoWidgetReceiver5x1"
            android:exported="true"
            android:label="@string/widget_label_5x1">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meteocompare_widget_info_5x1" />
        </receiver>

        <!-- ═══ Double-row widgets (hauteur = 2 cellules) ══════════════ -->

        <!-- 2×2 (carré) -->
        <receiver
            android:name=".widget.MeteoWidgetReceiver2x2"
            android:exported="true"
            android:label="@string/widget_label_2x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meteocompare_widget_info_2x2" />
        </receiver>

        <!-- 3×2 (bloc) -->
        <receiver
            android:name=".widget.MeteoWidgetReceiver3x2"
            android:exported="true"
            android:label="@string/widget_label_3x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meteocompare_widget_info_3x2" />
        </receiver>

        <!-- 4×2 (détaillé) -->
        <receiver
            android:name=".widget.MeteoWidgetReceiver4x2"
            android:exported="true"
            android:label="@string/widget_label_4x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meteocompare_widget_info_4x2" />
        </receiver>

        <!-- 5×2 (grand, taille maximale) -->
        <receiver
            android:name=".widget.MeteoWidgetReceiver5x2"
            android:exported="true"
            android:label="@string/widget_label_5x2">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meteocompare_widget_info_5x2" />
        </receiver>

        <!--
            Activity de configuration ouverte par le système à l'ajout du
            widget (et lors du reconfigure Android 12+). Elle attend
            EXTRA_APPWIDGET_ID dans son Intent, sauvegarde la config via
            l'API Glance, et retourne RESULT_OK.

            android:exported="true" pour la même raison que le receiver — le
            launcher démarre l'activité, donc un cross-process access.
        -->
        <activity
            android:name=".widget.MeteoWidgetConfigActivity"
            android:exported="true"
            android:theme="@style/Theme.MeteoCompare"
            android:label="@string/widget_config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>

</manifest>

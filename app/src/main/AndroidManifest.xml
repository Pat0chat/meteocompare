<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Permissions minimales — strictement nécessaires au fonctionnement.
        INTERNET : requise pour les services météo configurés (Open-Meteo et
        backend MeteoCompare pour la vigilance).
        ACCESS_NETWORK_STATE : permet de court-circuiter immédiatement les
        requêtes quand aucun réseau Internet validé n'est disponible.
        POST_NOTIFICATIONS : notifications météo locales, désactivées par
        défaut. Demandée à l'exécution (Android 13+) uniquement quand
        l'utilisateur active une notification dans les Réglages.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
        Pas de Google Play Services / Firebase / AdMob dans les dépendances,
        donc rien n'injecte la permission AD_ID (Advertising ID). Inutile d'avoir
        un tools:node="remove" — il déclencherait un warning manifest-merger
        ("tagged to remove other declarations but no other declaration present").
        Si une future dépendance l'ajoutait, on remettrait la suppression ici.
    -->

    <application
        android:name=".MeteoCompareApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MeteoCompare">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MeteoCompare.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Répare le travail périodique après reboot ou mise à jour de l'APK.
            exported=false : seuls les broadcasts système ciblant l'application
            peuvent l'invoquer. Le travail reste unique et ne se duplique pas.
        -->
        <!--
            Déclencheur léger du résumé quotidien. AlarmManager peut réveiller
            l'application en veille ; le travail météo réel est ensuite confié
            à WorkManager par le receiver.
        -->
        <receiver
            android:name=".notification.WeatherNotificationAlarmReceiver"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".widget.WidgetRefreshRepairReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.DATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Deux widgets redimensionnables : météo adaptative et synthèse À retenir.
             Si le nom du receiver change, Android ne migre pas automatiquement
             les widgets déjà placés ; l’utilisateur doit les ajouter à nouveau. -->
        <receiver
            android:name=".widget.MeteoWeatherWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_weather">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meteocompare_widget_info_weather" />
        </receiver>

        <receiver
            android:name=".widget.MeteoInsightWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_label_insight">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/meteocompare_widget_info_insight" />
        </receiver>

        <!--
            Activity de configuration ouverte par le système à l'ajout du
            widget (et lors du reconfigure Android 12+). Elle attend
            EXTRA_APPWIDGET_ID dans son Intent, sauvegarde la config via
            l'API Glance, et retourne RESULT_OK.

            android:exported="true" pour la même raison que le receiver — le
            launcher démarre l'activité, donc un cross-process access.
        -->
        <activity
            android:name=".widget.MeteoWidgetConfigActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MeteoCompare"
            android:label="@string/widget_config_title">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

    </application>

</manifest>

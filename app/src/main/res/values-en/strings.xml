    <string name="bias_explainer_opener">%1$s systematically %2$s %3$s here over the last %4$d days.</string>
    <!-- Explainer text for a CALIBRATED model (NOT_SIGNIFICANT). Single
         positive sentence — replaces the misleading "systematically overestimates"
         template that would otherwise fire for a genuinely well-behaved model. -->
    <string name="bias_explainer_calibrated">%1$s is well calibrated on %2$s at this location. Over the last %3$d days, the mean deviation from observations stays within daily noise — no correction is needed to interpret its forecasts.</string>

    <!-- Correction hint — varies by direction -->
    <string name="bias_hint_warm">Subtracting the deviation from its forecasts gives a reading closer to reality.</string>
    <string name="bias_hint_cold">Adding the deviation to its forecasts gives a reading closer to reality.</string>
    <string name="bias_hint_neutral">Nothing to correct on this variable.</string>

    <!-- Stability interpretation — varies by significance -->
    <string name="bias_stability_high">The bias is consistent over the last 30 days (low standard deviation relative to magnitude) — the observed pattern is not by chance.</string>
    <string name="bias_stability_moderate">The bias is visible but moderate — worth keeping in mind for close calls.</string>
    <string name="bias_stability_not_significant">Deviation close to daily noise — no action needed.</string>

    <!-- Progress announcement of the "calibrating" chip. Visible text is "N/14"

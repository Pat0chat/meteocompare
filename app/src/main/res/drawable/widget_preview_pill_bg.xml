<?xml version="1.0" encoding="utf-8"?>
<!--
    Fond de la "pill" de confiance dans les widget previews.

    Reproduit le rendu de [com.meteocompare.app.widget.MeteoWidget.ConfidencePill]
    tel qu'utilisé dans MediumLayout / LargeLayout / ExtraLargeLayout : petit
    badge arrondi (12dp radius) teinté selon le niveau de confiance :
      - >= 75% → vert  (haute confiance, on prend celui-ci pour le preview
                        car c'est le cas nominal)
      - >= 60% → ambre (confiance moyenne)
      - <  60% → rouge (basse confiance — signale la divergence)

    Le vert #43A047 (Material Green 600) reprend confidenceColor(75+) du code
    Kotlin. Contraste OK sur clair et sombre — texte blanc dessus est lisible
    quel que soit le thème système.

    Utilisation : android:background="@drawable/widget_preview_pill_bg" sur
    un TextView "85%" avec un texte blanc.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#43A047" />
    <corners android:radius="12dp" />
</shape>

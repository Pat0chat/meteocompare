<?xml version="1.0" encoding="utf-8"?>
<!--
    Preview du provider 1×1 UNIQUEMENT.

    Zone de rendu ~60-80dp × 60-80dp dans le picker. Trop petite pour
    afficher plus qu'une donnée majeure. On garde uniquement la température
    (donnée clé du widget) et rien d'autre — mieux vaut un petit widget
    lisible qu'un truc surchargé et illisible.

    Utilisé uniquement par meteocompare_widget_info_1x1.xml.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="18°"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

</FrameLayout>

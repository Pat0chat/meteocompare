<?xml version="1.0" encoding="utf-8"?>
<!--
    Preview des providers "wide-short" — targetCellHeight = 1.
    Utilisé pour meteocompare_widget_info_2x1.xml, _3x1.xml, _4x1.xml, _5x1.xml.

    ─── ⚠ Contrainte RemoteViews ─────────────────────────────────────
    Depuis Android 12, le launcher rend `previewLayout` via RemoteViews
    (LauncherAppsService). RemoteViews N'ACCEPTE QUE les vues annotées
    `@RemoteView` — la liste est courte : FrameLayout, LinearLayout,
    RelativeLayout, GridLayout, TextView, ImageView, Button, ImageButton,
    ProgressBar, ViewFlipper, ViewStub, quelques Adapter classes.

    NOTAMMENT PAS SUPPORTÉS :
      - `<View>` (classe brute)
      - `<Space>` (pas d'annotation @RemoteView)
      - Toute custom view

    Utiliser un `<View>` comme spacer avec layout_weight fait planter
    l'inflate côté launcher, qui affiche "couldn't add widget" au lieu
    du preview. Vu sur Pixel 9a — reproduit.

    ─── Structure sans spacer ────────────────────────────────────────
    On distribue le poids sur les DEUX enfants au lieu d'insérer un
    spacer intermédiaire :
      - TextView "18°" : wrap_content, pas de weight → prend sa taille naturelle
      - LinearLayout ville/confiance : weight=1, gravity=end → prend
        tout le reste et s'aligne à droite

    Résultat visuel identique à l'ancienne version avec `<View>` mais
    sans planter le picker.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="10dp"
    android:gravity="center_vertical"
    android:background="@drawable/widget_preview_bg">

    <!-- Température à gauche — élément dominant, taille naturelle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="18°"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <!-- Ville + confiance à droite, weight=1 pour occuper le reste
         gravity=end pour aligner le contenu à droite -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="end">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paris"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="85% · Ensoleillé"
            android:textSize="10sp"
            android:textColor="?android:attr/textColorSecondary"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>

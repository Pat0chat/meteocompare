<?xml version="1.0" encoding="utf-8"?>
<!--
    Preview des providers "wide-short" — targetCellHeight = 1.
    Utilisé pour meteocompare_widget_info_2x1.xml, _3x1.xml, _4x1.xml, _5x1.xml.

    ─── Fidélité au vrai widget ───────────────────────────────────────
    Reproduit la structure de [MeteoWidget.MediumLayout] (qui rend le 3×1
    dans le vrai widget) :

      [glyphe] [temp]  |  ville         [pill 85%]
                       |  15° / 22°

    Compromis assumé : la même preview est utilisée pour 2×1, 3×1, 4×1 et
    5×1 alors que ces tailles rendent des layouts LÉGÈREMENT différents
    dans le vrai widget (SmallLayout, MediumLayout, LargeLayout). Faire 4
    previews séparées serait diminishing returns — le pattern général
    "icône + temp + ville/min-max + confiance" est constant à travers ces
    tailles, seule la richesse des extras change (badges cloud/rain, items
    inline supplémentaires en 5×1). L'utilisateur qui hésite entre les
    tailles verra la MÊME impression générale et pourra choisir sur la
    largeur.

    ─── ⚠ Contrainte RemoteViews ─────────────────────────────────────
    Pas de `<View>` ni `<Space>` (non annotés @RemoteView). On distribue les
    poids sur les enfants LinearLayout — voir historique du fichier pour
    l'incident "couldn't add widget" du sprint précédent.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:padding="8dp"
    android:gravity="center_vertical"
    android:background="@drawable/widget_preview_bg">

    <!-- Bloc gauche : glyphe + température actuelle en Row inline -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="☀"
        android:textSize="24sp"
        android:layout_marginEnd="4dp"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="18°"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <!-- Bloc central : ville + min/max — prend l'espace restant (weight=1) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paris"
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="15° / 22°"
            android:textSize="11sp"
            android:textColor="?android:attr/textColorSecondary"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

    <!-- Pill de confiance — reproduit ConfidencePill du vrai widget -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="85%"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:background="@drawable/widget_preview_pill_bg"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:paddingTop="2dp"
        android:paddingBottom="2dp" />

</LinearLayout>

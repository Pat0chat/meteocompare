<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Ne jamais restaurer un cache météo/marine périmé sur un nouvel appareil. -->
        <include domain="file" path="datastore/user_prefs.preferences_pb" />
        <include domain="file" path="datastore/favorites.preferences_pb" />
        <include domain="sharedpref" path="meteocompare_locale_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/user_prefs.preferences_pb" />
        <include domain="file" path="datastore/favorites.preferences_pb" />
        <include domain="sharedpref" path="meteocompare_locale_prefs.xml" />
    </device-transfer>
</data-extraction-rules>

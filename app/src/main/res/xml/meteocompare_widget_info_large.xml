<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget MeteoCompare — variante GRAND (5×2).

    Le plus grand widget disponible. Occupe 10 cellules (5 largeur × 2
    hauteur). Rendu maximaliste : header complet (icône, temp, ville,
    min/max, extras, confiance) + strip du bas avec 5 items de prévision
    étendue au lieu de 4.

    ─── Dimensions ─────────────────────────────────────────────────
    - minWidth=250dp minHeight=110dp : plancher = 4×2. Sous 4 cellules
      de large, la variante "grand" n'a plus de sens visuel — le layout
      détaillé devient trop resserré. Le user peut basculer vers le
      provider Standard s'il veut du plus petit.
    - targetCellWidth=5 targetCellHeight=2 : cible 5×2. Sur grille
      5-colonnes = utilise TOUTE la largeur. Sur grille 4-colonnes,
      launcher clampe à 4 et affiche un 4×2 (le layout s'adapte).
    - maxResizeWidth=360dp maxResizeHeight=180dp : pas de raison d'aller
      plus haut — 5×2 est déjà le plafond des grilles standard.

    ─── Layout côté widget ─────────────────────────────────────────
    Le rendu 5×2 réutilise ExtraLargeLayout de [MeteoWidget], qui
    détecte width ≥ 380dp pour afficher 5 items de prévision étendue
    au lieu de 4. Aucun layout dédié — la logique de bucket adapte.
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:targetCellWidth="5"
    android:targetCellHeight="2"
    android:maxResizeWidth="360dp"
    android:maxResizeHeight="180dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"
    android:configure="com.meteocompare.app.widget.MeteoWidgetConfigActivity"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_description" />

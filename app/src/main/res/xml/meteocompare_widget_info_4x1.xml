<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget MeteoCompare — provider CIBLE 4×1.

    ─── Rôle parmi les 9 providers ─────────────────────────────────
    Ce fichier concerne l'entrée "Météo" à la taille cible 4×1. Voir
    AndroidManifest.xml pour la liste complète des receivers.

    ─── Dimensions HOMOGÈNES pour tous les providers ───────────────
    Depuis l'itération "cohérence", tous les providers partagent la MÊME
    plage de resize :
      - minWidth  = 40dp   (1 cellule — permet resize vers 1×1)
      - minHeight = 40dp
      - maxResizeWidth  = 1200dp (bornes très hautes pour ne JAMAIS bloquer
        le placement sur launchers larges — voir issue Pixel 9a 5×1)
      - maxResizeHeight = 1200dp (idem — pas de contrainte artificielle)

    Conséquence : sur un launcher qui supporte le resize, l'utilisateur
    peut partir de N'IMPORTE QUEL provider et arriver à N'IMPORTE QUELLE
    taille finale. Le rôle des 9 providers devient purement "point de
    départ visuel dans le picker" — pas une contrainte de taille.

    Sur les launchers sans resize post-drop, le user reste à la cible.
    D'où l'importance d'exposer les 9 tailles dans le picker.

    ─── Ce qui distingue ce provider des autres ────────────────────
    UNIQUEMENT `targetCellWidth=4` et `targetCellHeight=1`. Toutes les
    autres attributs sont identiques.
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="40dp"
    android:minHeight="40dp"
    android:targetCellWidth="4"
    android:targetCellHeight="1"
    android:maxResizeWidth="1200dp"
    android:maxResizeHeight="1200dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"
    android:configure="com.meteocompare.app.widget.MeteoWidgetConfigActivity"
    android:previewImage="@mipmap/ic_launcher"
    android:previewLayout="@layout/widget_preview_wide"
    android:description="@string/widget_description" />

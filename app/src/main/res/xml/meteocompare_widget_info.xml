<?xml version="1.0" encoding="utf-8"?>
<!--
    Meta-données du widget MeteoCompare.

    Dimensions :
      - minWidth=110dp minHeight=40dp : taille MINIMALE (2×1 cellules approx).
        Le système peut refuser d'afficher plus petit ; certains launchers vont
        même bloquer si la cellule cible est plus petite.
      - targetCellWidth/Height : taille NATURELLE au drop initial (Android 12+).
        On vise 2×1 par défaut — l'utilisateur peut ensuite resize horizontalement
        jusqu'au maxResize.
      - maxResizeWidth=290dp : autorise jusqu'à 4 cellules horizontales (4×1).
        Formule Android grid : width_dp = 70 · n − 30. 4×1 → 250dp, on prend
        290 avec marge pour les launchers qui arrondissent.
      - resizeMode="horizontal|vertical" : autorise resize latéral ET vertical,
        pour permettre au user de passer de 4×1 à 4×2 en tirant vers le bas.

    Rafraîchissement :
      - updatePeriodMillis=0 : DÉSACTIVE le refresh AlarmManager du système.
        Avant, on avait 1800000 (30 min) — le minimum autorisé par le système.
        Le refresh est maintenant piloté par [WidgetRefreshScheduler] +
        [WidgetRefreshWorker] via WorkManager. Cela donne :

          · Respect de Doze / App Standby / Battery Saver (le worker se
            groupe avec les autres jobs pour minimiser les wake-ups).
          · Contrainte NETWORK CONNECTED : aucune tentative de fetch en
            offline (économie majeure batterie en mode avion/tunnel).
          · Contrainte BATTERY_NOT_LOW : pas de refresh auto si batterie
            basse — le user peut toujours refresh manuellement via l'app.
          · Intervalle CONFIGURABLE (15 min à 6 h, ou MANUEL) via les
            settings de l'app. Auparavant hardcodé à 30 min.

        Laisser updatePeriodMillis > 0 en parallèle du worker double le
        refresh (une passe AlarmManager + une passe worker) et casse les
        contraintes battery/network puisque AlarmManager les ignore. On MET
        DONC EXPLICITEMENT 0 pour désactiver.

    Configuration :
      - configure="..MeteoWidgetConfigActivity" : au drop du widget, le système
        ouvre cette activité pour permettre à l'utilisateur de choisir sa ville
        et l'opacité. Sans cette ligne, le widget apparaîtrait avec l'état
        "non configuré" (voir WidgetError.NotConfigured).
      - widgetFeatures="reconfigurable" : ajoute un menu "Reconfigurer" sur
        long-press du widget (Android 12+). Utile pour changer de ville sans
        supprimer/re-ajouter le widget.

    Preview :
      - previewImage : miniature affichée dans le picker de widgets. On réutilise
        l'icône launcher — plus propre serait un vrai preview layout mais on
        garde ça pour une itération future.
-->
<appwidget-provider
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:maxResizeWidth="290dp"
    android:maxResizeHeight="180dp"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"
    android:configure="com.meteocompare.app.widget.MeteoWidgetConfigActivity"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_description" />

<?xml version="1.0" encoding="utf-8"?>
<!--
    Strings supplémentaires liées au widget : palettes de couleurs, labels
    des 9 variantes de tailles, section colors de la config activity.

    ─── Pourquoi un fichier séparé ? ───────────────────────────────
    Le strings.xml principal est déjà volumineux. Ajouter les ~25 clés
    nouvelles dans un fichier dédié :
      - Facilite le diff en review (les changements sont isolés).
      - Documente le scope (tout ce qui touche au widget est ici).
      - Aucun impact runtime : aapt merge tous les strings.xml d'un même
        module au build.

    ─── Format des labels : SIZE FIRST ─────────────────────────────
    Format "N×N Météo" — la taille est le PREMIER élément du label. Ce
    choix est crucial pour l'ordre d'affichage dans le picker :

      1. Certains launchers (Pixel, One UI récents) trient les widgets
         d'une app par ORDRE ALPHABÉTIQUE du label. Avec "Météo 1×1"
         d'abord, le préfixe commun "Météo " ne discrimine rien et
         c'est le caractère suivant qui décide — sur Pixel spécifique-
         ment, l'algorithme de tri peut hésiter sur des labels très
         proches et retomber sur l'ordre d'installation.

      2. Avec "1×1 Météo" en tête, le PREMIER caractère du label est
         le chiffre de la largeur, décisif dès le premier tri. Ordre
         résultant strictement identique à l'ordre par taille croissante
         (single-row d'abord, puis double-row) :

           "1×1 Météo" < "2×1 Météo" < "2×2 Météo"
                     < "3×1 Météo" < "3×2 Météo"
                     < "4×1 Météo" < "4×2 Météo"
                     < "5×1 Météo" < "5×2 Météo"

      3. Bonus UX : la taille étant l'info discriminante entre les 9
         variantes, la mettre en tête réduit le temps de scan visuel de
         l'utilisateur qui cherche une taille précise.

    ─── Note technique sur "×" ─────────────────────────────────────
    Le caractère × est U+00D7 (Multiplication Sign), pas la lettre "x".
    Rendu propre sur toutes les polices modernes (Roboto, San Francisco,
    Noto). Sémantiquement correct pour indiquer des dimensions.
-->
<resources>

    <!-- ─── Labels des 9 variantes (affichés dans le picker) ─── -->
    <!-- Ordre = ordre d'apparition attendu dans le picker après tri
         alphabétique par le launcher. Voir docblock ci-dessus. -->
    <string name="widget_label_1x1">1×1 Météo</string>
    <string name="widget_label_2x1">2×1 Météo</string>
    <string name="widget_label_2x2">2×2 Météo</string>
    <string name="widget_label_3x1">3×1 Météo</string>
    <string name="widget_label_3x2">3×2 Météo</string>
    <string name="widget_label_4x1">4×1 Météo</string>
    <string name="widget_label_4x2">4×2 Météo</string>
    <string name="widget_label_5x1">5×1 Météo</string>
    <string name="widget_label_5x2">5×2 Météo</string>

    <!-- Section couleurs dans la config activity -->
    <string name="widget_config_colors_section">Couleurs</string>
    <string name="widget_config_colors_bg">Fond</string>
    <string name="widget_config_colors_text">Texte</string>
    <string name="widget_config_colors_note">Auto suit le thème du système. L\'opacité s\'applique par-dessus la couleur choisie.</string>

    <!-- Noms des couleurs (utilisés en TalkBack / contentDescription) -->
    <string name="widget_color_auto">Auto</string>
    <string name="widget_color_white">Blanc</string>
    <string name="widget_color_black">Noir</string>
    <string name="widget_color_blue">Bleu</string>
    <string name="widget_color_teal">Turquoise</string>
    <string name="widget_color_green">Vert</string>
    <string name="widget_color_orange">Orange</string>
    <string name="widget_color_red">Rouge</string>
    <string name="widget_color_purple">Violet</string>
    <string name="widget_color_light_grey">Gris clair</string>
    <string name="widget_color_dark_grey">Gris foncé</string>

    <!-- Titres des panneaux de prévision modernisés -->
    <string name="widget_forecast_hours">Prochaines heures</string>
    <string name="widget_forecast_days">Prochains jours</string>
    <string name="widget_forecast_generic">Prévisions</string>
    <string name="widget_forecast_confidence">Confiance des modèles</string>
    <string name="widget_forecast_confidence_hint">accord / modèles</string>
    <string name="widget_forecast_confidence_short">Conf. %1$d%%</string>


    <!-- Widgets éditoriaux MeteoCompare -->
    <string name="widget_label_insight">4×2 À retenir</string>
    <string name="widget_label_consensus">4×2 Consensus</string>
    <string name="widget_description_insight">Le signal météo le plus utile et son niveau d’accord entre modèles.</string>
    <string name="widget_description_consensus">Comparaison compacte des scénarios de température, pluie et vent.</string>
    <string name="widget_value_consensus_title">Consensus des modèles</string>
    <string name="widget_value_models">%1$d modèles</string>
    <string name="widget_value_now">Maintenant</string>
    <string name="widget_value_next">Prochaine échéance</string>
    <string name="widget_value_hour">%1$02d h</string>
    <string name="widget_value_temperature">%1$d°</string>
    <string name="widget_value_percent">%1$d %%</string>
    <string name="widget_value_precip">%1$.1f mm</string>
    <string name="widget_value_wind">%1$d km/h</string>
    <string name="widget_value_temperature_range">%1$d–%2$d°</string>
    <string name="widget_value_probability_range">%1$d–%2$d %%</string>
    <string name="widget_value_precip_range">%1$.1f–%2$.1f mm</string>
    <string name="widget_value_wind_range">%1$d–%2$d km/h</string>
    <string name="widget_value_detail_range_consensus">%1$s · %2$d %% d’accord</string>
    <plurals name="widget_value_detail_range_models">
        <item quantity="one">%1$s · %2$d modèle</item>
        <item quantity="other">%1$s · %2$d modèles</item>
    </plurals>
    <string name="widget_value_detail_consensus">%1$d %% d’accord entre modèles</string>
    <string name="widget_value_metric_temperature">Température</string>
    <string name="widget_value_metric_precipitation">Pluie</string>
    <string name="widget_value_metric_wind">Vent</string>
    <string name="widget_value_agreement_models_short">%1$d %% · %2$d m</string>
    <string name="widget_value_agreement_short">%1$d %%</string>
    <string name="widget_value_no_comparison">Comparaison indisponible</string>
    <string name="widget_value_open_app">Ouvrir MeteoCompare</string>

</resources>
